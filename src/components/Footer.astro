---
import type { GetFooterQueryResult } from '../shared/sanity.types.ts';

interface Props {
	footer: GetFooterQueryResult;
	locale: string;
}

const { footer, locale } = Astro.props;
const columns = footer?.footerColumns ?? [];
const columnGridClass =
	columns.length === 1
		? 'md:grid-cols-1'
		: columns.length === 2
			? 'md:grid-cols-2'
			: 'md:grid-cols-3';
---

<footer class="bg-[var(--color-footer-background)] text-[var(--color-footer-text)]">
	<div class="mx-auto max-w-[1280px] px-5 py-10 md:px-16 md:py-12">
		{columns.length > 0 && (
			<nav
				aria-label="Footer navigation"
				class={`mx-auto grid max-w-3xl grid-cols-1 justify-items-center gap-8 text-center sm:grid-cols-2 ${columnGridClass}`}
			>
				{columns.map(
					(column) =>
						column?.title && (
							<section class="text-left">
								<h2 class="text-sm font-bold text-[var(--color-footer-text)]">{column.title}</h2>
								{column.links && column.links.length > 0 && (
									<ul class="mt-3 space-y-2">
										{column.links.map(
											(link) =>
												link?.title &&
												link.slug && (
													<li>
														<a
															class="inline-block text-sm text-[var(--color-footer-link)] underline-offset-4 transition-colors hover:text-[var(--color-footer-text)] hover:underline focus:outline-2 focus:outline-offset-4 focus:outline-[var(--color-footer-text)]"
															href={`/${locale}/${link.slug}`}
														>
															{link.title}
														</a>
													</li>
												),
										)}
									</ul>
								)}
							</section>
						),
				)}
		</nav>
		)}

		<div class="mt-10 border-t border-[var(--color-footer-border)] pt-5 text-center text-xs text-[var(--color-footer-muted)]">
			<span>{footer?.copyright ?? ''}</span><span aria-hidden="true"> &#169; </span>
			<span data-current-year aria-label="current year"></span>
		</div>
	</div>
</footer>

<script>
	const yearElement = document.querySelector('[data-current-year]');

	if (yearElement) {
		yearElement.textContent = new Date().getFullYear().toString();
	}
</script>
