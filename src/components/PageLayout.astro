---
import Header from './Header.astro';
import Footer from './Footer.astro';

import { sanityClient } from 'sanity:client';
import {
	getEntryBySlugAndLocale,
	getFooterQuery,
	headerInfoQuery,
	sluggableContentTypesQuery,
} from '../shared/queries.ts';
import type {
	GetEntryBySlugAndLocaleResult,
	GetFooterQueryResult,
	HeaderInfoQueryResult,
	SluggableContentTypesQueryResult,
} from '../shared/sanity.types.ts';
import { languages } from '../../sanity/config.ts';
import { getTranslations } from '../shared/translations.ts';
interface Props {
	locale: string;
	slug?: string;
	entry?: GetEntryBySlugAndLocaleResult;
}

const { locale, slug, entry: providedEntry } = Astro.props;
const t = getTranslations(locale);

const hrefLangs: Record<string, string> = {
	en: 'en-US',
	tr: 'tr-TR',
};

let alternateTranslations = languages.map((locale) => ({
	name: locale.title,
	code: locale.code,
	href: locale.code,
	hreflang: hrefLangs[locale.code] ?? locale.code,
}));

const header = await sanityClient.fetch<HeaderInfoQueryResult>(headerInfoQuery, {
	locale,
});
const footer = await sanityClient.fetch<GetFooterQueryResult>(getFooterQuery, {
	locale,
});

let entry: GetEntryBySlugAndLocaleResult = providedEntry ?? null;

if (!entry && slug) {
	const contentTypes: SluggableContentTypesQueryResult = await sanityClient.fetch(
		sluggableContentTypesQuery,
	);

	entry = await sanityClient.fetch(getEntryBySlugAndLocale, {
		types: contentTypes,
		locale,
		slug,
	});
}


if (entry) {
	const localeMap = Object.fromEntries(languages.map((locale) => [locale.code, locale.title]));

	alternateTranslations = (entry.slugs ?? []).map(({ code, slug }) => ({
		code,
		href: slug!,
		name: localeMap[code] ?? code,
		hreflang: hrefLangs[code] ?? code,
	}));
}

const canonicalLang = alternateTranslations.find((l) => l.code === locale)!
const mainLang = alternateTranslations.find((l) => l.code === 'tr')!
const canonicalUrl = `${Astro.url.origin}/${canonicalLang.code}/${canonicalLang.href}`
---

<html lang={locale}>
	<head>
		<title>{t.siteTitle}</title>

		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		{ entry &&
			<>
			<link rel="canonical" href={canonicalUrl} />
			{
				alternateTranslations.map((translation) =>
					<link rel="alternate" hreflang={translation.hreflang}
					      href={`${Astro.url.origin}/${translation.code}/${translation.href}`} />
				)
			}
			<link rel="alternate" hreflang="x-default" href=`${Astro.url.origin}/${mainLang.code}/${mainLang.href}`/>

			<meta name="description" content={entry.metaDescription}/>

			<meta property="og:title" content={entry.title}/>
			<meta property="og:type" content="website"/>
			<meta property="og:url" content={canonicalUrl}/>
			<meta property="og:image" content={header!.opengraph_logo?.asset?.url}/>
			<meta property="og:description" content={entry.metaDescription}/>
			<meta property="og:locale" content={locale}/>

				{
					alternateTranslations.map((translation) =>
						<meta property="og:locale:alternate" content={translation.code}/>
					)
				}
	</>
		}
	</head>
	<body class="flex min-h-screen flex-col">
		<Header locale={locale} header={header} alternateTranslations={alternateTranslations} />
		<main class="flex-1">
			<slot />
		</main>
		<Footer footer={footer} locale={locale} />
	</body>
</html>
