---
import Header from './Header.astro';
import Footer from './Footer.astro';

import type {
	GetEntryBySlugAndLocaleResult,
	GetFooterQueryResult,
	HeaderInfoQueryResult,
} from '../shared/sanity.types.ts';
import { languages } from '../../sanity/config.ts';
import { getTranslations } from '../shared/translations.ts';
import { getSanityImageProps } from '../shared/sanityImage.ts';
interface Props {
	locale: string;
	slug?: string;
	entry?: GetEntryBySlugAndLocaleResult;
	header: HeaderInfoQueryResult;
	footer: GetFooterQueryResult;
}

const { locale, slug, entry, header, footer } = Astro.props;
const t = getTranslations(locale);

const hrefLangs: Record<string, string> = {
	en: 'en-US',
	tr: 'tr-TR',
};

let alternateTranslations = languages.map((locale) => ({
	name: locale.title,
	code: locale.code,
	href: locale.code,
	hreflang: hrefLangs[locale.code] ?? locale.code,
}));

if (entry) {
	const localeMap = Object.fromEntries(languages.map((locale) => [locale.code, locale.title]));

	alternateTranslations = (entry.slugs ?? []).map(({ code, slug }) => ({
		code,
		href: slug!,
		name: localeMap[code] ?? code,
		hreflang: hrefLangs[code] ?? code,
	}));
}

const canonicalLang = alternateTranslations.find((l) => l.code === locale)!;
const mainLang = alternateTranslations.find((l) => l.code === 'tr')!;
const canonicalUrl = `${Astro.url.origin}/${canonicalLang.code}/${canonicalLang.href}`;
const openGraphImage = header?.opengraph_logo?.asset?.url
	? getSanityImageProps(header.opengraph_logo.asset.url, {
			widths: [1200],
			fallbackWidth: 1200,
		})
	: null;
---

<html lang={locale}>
	<head>
		<title>{t.siteTitle}</title>

		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		{
			entry && (
				<>
					<link rel="canonical" href={canonicalUrl} />
					{alternateTranslations.map((translation) => (
						<link
							rel="alternate"
							hreflang={translation.hreflang}
							href={`${Astro.url.origin}/${translation.code}/${translation.href}`}
						/>
					))}
					<link
						rel="alternate"
						hreflang="x-default"
						href={`${Astro.url.origin}/${mainLang.code}/${mainLang.href}`}
					/>

					<meta name="description" content={entry.metaDescription} />

					<meta property="og:title" content={entry.title} />
					<meta property="og:type" content="website" />
					<meta property="og:url" content={canonicalUrl} />
					{openGraphImage && <meta property="og:image" content={openGraphImage.src} />}
					<meta property="og:description" content={entry.metaDescription} />
					<meta property="og:locale" content={locale} />

					{alternateTranslations.map((translation) => (
						<meta property="og:locale:alternate" content={translation.code} />
					))}
				</>
			)
		}
	</head>
	<body class="flex min-h-screen flex-col">
		<Header locale={locale} header={header} alternateTranslations={alternateTranslations} />
		<main class="flex-1">
			<slot />
		</main>
		<Footer footer={footer} locale={locale} />
	</body>
</html>
