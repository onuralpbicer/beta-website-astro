---
import type { GetEntryBySlugAndLocaleResult } from '../shared/sanity.types.ts';

type Entry = Extract<NonNullable<GetEntryBySlugAndLocaleResult>, { _type: 'productPage' }>;

interface Props {
	entry: Entry;
	locale: string;
}

const { entry, locale } = Astro.props;
const product = entry.page;
---

<article class="mx-auto grid max-w-[1280px] gap-10 px-5 py-12 md:grid-cols-2 md:px-16">
	{product.image && <img class="w-full rounded-lg object-cover" src={product.image} alt={entry.title ?? ''} />}
	<div>
		<h1 class="text-4xl font-bold">{entry.title}</h1>
		{product.brand && <p class="mt-3 text-sm">{product.brand}</p>}
		{product.description && <p class="mt-6 leading-7">{product.description}</p>}
		{product.price.price != null && (
			<p class="mt-6 text-2xl font-bold">
				{product.price.price} {product.price.currency}
			</p>
		)}
		{product.document.url && (
			<a class="mt-6 inline-block underline" href={product.document.url} download>
				{product.document.name ?? 'Download document'}
			</a>
		)}
		{product.keyFeatures && (
			<ul class="mt-8 list-disc space-y-2 pl-5">
				{product.keyFeatures.map((feature) => <li>{feature}</li>)}
			</ul>
		)}
	</div>
</article>
