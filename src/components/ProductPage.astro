---
import type { GetEntryBySlugAndLocaleResult } from '../shared/sanity.types.ts';
import { getTranslations } from '../shared/translations.ts';
import ProductCard from './ProductCard.astro';

type Entry = Extract<NonNullable<GetEntryBySlugAndLocaleResult>, { _type: 'productPage' }>;

interface Props {
	entry: Entry;
	locale: string;
}

const { entry, locale } = Astro.props;
const product = entry.page;
const t = getTranslations(locale);
const price =
	product.price.price != null
		? `${product.price.price.toLocaleString(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${product.price.currency ?? ''}`.trim()
		: '';
---

<article class="text-(--color-page-text)">
	<section class="bg-[#f3f6fc]">
		<div
			class="mx-auto grid w-[calc(100%-2rem)] max-w-[1120px] gap-8 py-12 md:grid-cols-[minmax(0,1.08fr)_minmax(0,.92fr)] md:gap-12 md:py-16"
		>
			<div
				class="grid min-h-[260px] place-items-center rounded-[9px] border border-[#d8e1ed] bg-white p-3.5"
			>
				{
					product.image ? (
						<img
							class="block max-h-[360px] w-full rounded-md object-contain"
							src={product.image}
							alt={entry.title ?? ''}
						/>
					) : (
						<div class="aspect-[1.4] w-full bg-[#eef3f9]" />
					)
				}
			</div>
			<div class="self-center">
				<h1
					class="m-[.45rem_0_1rem] text-[clamp(1.6rem,4vw,2.45rem)] leading-[1.05] font-extrabold uppercase"
				>
					{entry.title}
				</h1>
				{
					product.description && (
						<p class="mb-4 max-w-[38rem] text-[.82rem] leading-[1.55] text-[#4a5565]">
							{product.description}
						</p>
					)
				}
				<dl class="m-0 border-b border-[#dbe3ed] text-[.72rem]">
					<div class="my-1.5 flex gap-2">
						<dt class="font-extrabold">{t.product.brand}</dt><dd class="m-0 text-[#556171]">
							{product.brand}
						</dd>
					</div>
					<div class="my-1.5 flex gap-2">
						<dt class="font-extrabold">{t.product.productCode}</dt><dd class="m-0 text-[#556171]">
							{product.productCode}
						</dd>
					</div>
				</dl>
				{price && <p class="mt-3 text-[1.35rem] font-extrabold text-[#286395]">{price}</p>}
				{
					product.price.taxIncluded != null && (
						<small class="text-[.58rem] text-[#6c7785]">
							{product.price.taxIncluded ? t.product.vatIncluded : t.product.vatExcluded}
						</small>
					)
				}
				<div class="mt-3.5 flex flex-wrap gap-2.5">
					<a
						class="inline-flex min-h-[2.4rem] items-center justify-center rounded-[7px] bg-[#286395] px-4 py-2 text-[.68rem] font-bold text-white no-underline"
						href={`mailto:info@betamuhendislik.com?subject=${encodeURIComponent(entry.title ?? '')}`}
						>{t.product.contact}</a
					>
					{
						product.document?.url && (
							<a
								class="inline-flex min-h-[2.4rem] items-center justify-center rounded-[7px] border border-[#286395] px-4 py-2 text-[.68rem] font-bold text-[#286395] no-underline"
								href={product.document.url}
								download
							>
								{t.product.downloadBrochure}
							</a>
						)
					}
				</div>
			</div>
		</div>
	</section>

	<section class="bg-white">
		<div class="mx-auto w-[calc(100%-2rem)] max-w-[1120px] py-12">
			<span class="block text-[.6rem] font-extrabold tracking-[.04em] text-[#2e6898]"
				>{t.product.featuresEyebrow}</span
			>
			<h2 class="m-[.35rem_0_1.35rem] text-[1.45rem] font-extrabold">{t.product.featuresTitle}</h2>
			{
				product.keyFeatures?.length ? (
					<ul class="m-0 grid list-none gap-2.5 p-0 text-[.78rem]">
						{product.keyFeatures.map((feature) => (
							<li class="flex items-start gap-2.5 before:grid before:h-4 before:w-4 before:flex-none before:place-items-center before:rounded-full before:bg-[#e5f0f6] before:text-[.65rem] before:font-extrabold before:text-[#286395] before:content-['✓']">
								{feature}
							</li>
						))}
					</ul>
				) : (
					<p class="text-[.8rem] text-[#647080]">{t.product.featuresEmpty}</p>
				)
			}
		</div>
	</section>

	{
		product.relatedProducts?.length ? (
			<section class="bg-[#f3f6fc]">
				<div class="mx-auto w-[calc(100%-2rem)] max-w-[1120px] py-12">
					<span class="block text-[.6rem] font-extrabold tracking-[.04em] text-[#2e6898]">
						{t.product.catalogEyebrow}
					</span>
					<h2 class="m-[.35rem_0_1.35rem] text-[1.45rem] font-extrabold">
						{t.product.relatedTitle}
					</h2>
					<div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 md:grid-cols-3">
						{product.relatedProducts.map((related) => (
							<ProductCard product={related} locale={locale} />
						))}
					</div>
				</div>
			</section>
		) : null
	}
</article>
