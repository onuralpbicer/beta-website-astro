---
import type { GetEntryBySlugAndLocaleResult } from '../shared/sanity.types.ts';
import { getTranslations } from '../shared/translations.ts';
import ProductList, { type ProductListItem } from './ProductList.astro';

type Entry = Extract<
	NonNullable<GetEntryBySlugAndLocaleResult>,
	{ _type: 'productCategoriesPage' }
>;

interface Props {
	entry: Entry;
	locale: string;
}

const { entry, locale } = Astro.props;
const t = getTranslations(locale);
const items: ProductListItem[] = (entry.page.products ?? []).map((item) => ({
	_type: item._type,
	title: item.title,
	slug: item.slug,
	description: item.description,
	image: item.image,
	price: item._type === 'productPage' ? item.price : null,
	currency: item._type === 'productPage' ? item.currency : null,
	count: item._type === 'productSubcategoriesPage' ? (item.products?.length ?? 0) : undefined,
}));
---

<article class="bg-(--color-page-background) text-(--color-page-text)">
	<div class="mx-auto w-[calc(100%-2rem)] max-w-[1120px] py-10 md:py-14">
		<span class="block text-[.6rem] font-extrabold tracking-[.04em] text-[#2e6898]"
			>{entry.title}</span
		>
		<h1 class="m-[.35rem_0_.75rem] text-[clamp(1.7rem,4vw,2.4rem)] leading-none font-extrabold">
			{entry.title}
		</h1>
		{
			entry.page.description && (
				<p class="mb-8 max-w-4xl text-[.78rem] leading-[1.55] text-[#4a5565]">
					{entry.page.description}
				</p>
			)
		}
		<div>
			<div class="mb-3 flex items-center justify-between text-[.68rem] font-bold text-[#556171]">
				<span>{items.length} {items.length === 1 ? t.productList.item : t.productList.items}</span
				><span class="hidden sm:block">{entry.title}</span>
			</div><ProductList items={items} locale={locale} />
		</div>
	</div>
</article>
