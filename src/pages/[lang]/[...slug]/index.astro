---
import { sanityClient } from 'sanity:client';
import PageLayout from '../../../components/PageLayout.astro';
import HomeHero from '../../../components/HomeHero.astro';
import HomeFeatured from '../../../components/HomeFeatured.astro';
import ProductCategoriesPage from '../../../components/ProductCategoriesPage.astro';
import ProductPage from '../../../components/ProductPage.astro';
import ProductSubcategoriesPage from '../../../components/ProductSubcategoriesPage.astro';
import RichTextPage from '../../../components/RichTextPage.astro';
import ServicesPage from '../../../components/ServicesPage.astro';
import '../../../styles/global.css';
import {
	getEntriesQuery,
	getEntryBySlugAndLocale,
	sluggableContentTypesQuery,
	headerInfoQuery,
	getFooterQuery,
} from '../../../shared/queries.ts';
import type {
	GetEntriesQueryResult,
	GetEntryBySlugAndLocaleResult,
	GetFooterQueryResult,
	HeaderInfoQueryResult,
	SluggableContentTypesQueryResult,
} from '../../../shared/sanity.types.ts';
export async function getStaticPaths() {
	const [entries, contentTypes, headerEn, headerTr, footerEn, footerTr] = await Promise.all([
		sanityClient.fetch<GetEntriesQueryResult>(getEntriesQuery),
		sanityClient.fetch<SluggableContentTypesQueryResult>(sluggableContentTypesQuery),
		sanityClient.fetch<HeaderInfoQueryResult>(headerInfoQuery, { locale: 'en' }),
		sanityClient.fetch<HeaderInfoQueryResult>(headerInfoQuery, { locale: 'tr' }),
		sanityClient.fetch<GetFooterQueryResult>(getFooterQuery, { locale: 'en' }),
		sanityClient.fetch<GetFooterQueryResult>(getFooterQuery, { locale: 'tr' }),
	]);

	const sharedByLocale = {
		en: { contentTypes, header: headerEn, footer: footerEn },
		tr: { contentTypes, header: headerTr, footer: footerTr },
	};

	const paths = entries.flatMap((entry) =>
		entry?.locale && entry.slug ? [{ locale: entry.locale, slug: entry.slug }] : [],
	);

	return Promise.all(
		paths.map(async ({ locale, slug }) => {
			const shared = sharedByLocale[locale as keyof typeof sharedByLocale];
			const entry = await sanityClient.fetch<GetEntryBySlugAndLocaleResult>(
				getEntryBySlugAndLocale,
				{ types: shared.contentTypes, locale, slug },
			);

			return {
				params: { lang: locale, slug },
				props: { shared, entry },
			};
		}),
	);
}

const { lang, slug } = Astro.params;
const { shared, entry } = Astro.props;

if (!entry) {
	return new Response(null, { status: 404 });
}

let pageKind:
	'home' | 'richText' | 'product' | 'productCategories' | 'productSubcategories' | 'services';

switch (entry._type) {
	case 'homePage':
		pageKind = 'home';
		break;
	case 'richTextPage':
		pageKind = 'richText';
		break;
	case 'productPage':
		pageKind = 'product';
		break;
	case 'productCategoriesPage':
		pageKind = 'productCategories';
		break;
	case 'productSubcategoriesPage':
		pageKind = 'productSubcategories';
		break;
	case 'servicesPage':
		pageKind = 'services';
		break;
	default:
		return new Response(null, { status: 404 });
}
---

<PageLayout locale={lang} slug={slug} entry={entry} header={shared.header} footer={shared.footer}>
	{
		pageKind === 'home' && entry._type === 'homePage' && (
			<>
				<HomeHero entry={entry} locale={lang} />
				<HomeFeatured entry={entry} locale={lang} />
			</>
		)
	}
	{pageKind === 'richText' && entry._type === 'richTextPage' && <RichTextPage entry={entry} />}
	{
		pageKind === 'product' && entry._type === 'productPage' && (
			<ProductPage entry={entry} locale={lang} />
		)
	}
	{
		pageKind === 'productCategories' && entry._type === 'productCategoriesPage' && (
			<ProductCategoriesPage entry={entry} locale={lang} />
		)
	}
	{
		pageKind === 'productSubcategories' && entry._type === 'productSubcategoriesPage' && (
			<ProductSubcategoriesPage entry={entry} locale={lang} />
		)
	}
	{
		pageKind === 'services' && entry._type === 'servicesPage' && (
			<ServicesPage entry={entry} locale={lang} />
		)
	}
</PageLayout>
